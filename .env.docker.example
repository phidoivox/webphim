# ──────────────────────────────────────────────────
# Docker environment — COPY thành .env.docker
# KHÔNG bake secret vào image, dùng file này runtime
# ──────────────────────────────────────────────────

APP_NAME=WebPhim
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
# Tạo key: php artisan key:generate --show
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ─── Logging (stderr cho docker logs) ───
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_LEVEL=warning

# ─── Database (service name = db) ───
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=webphim
DB_USERNAME=webphim
DB_PASSWORD=secret

# ─── Redis (service name = redis) ───
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ─── Session / Queue / Cache / Broadcast ───
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# ─── Reverb (service name = reverb, bind 0.0.0.0) ───
# BẮT BUỘC điền trước khi build: REVERB_APP_KEY được bake vào frontend image.
# Đổi key sau khi build xong = phải build lại frontend.
# KHÔNG để 0.0.0.0: hostname dùng check TLS cert (https) — browser ws đi qua nginx :80 nên để localhost.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# ─── Frontend & CORS ───
FRONTEND_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
REVALIDATION_SECRET=

# ─── Mail (log in prod until SMTP configured) ───
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@webphim.local"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Vite ───
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
